{
  "name": "faultlab",
  "version": "0.0.0",
  "private": true,
  "description": "A workspace for future fault-injection experiments.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./examples/*\" run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm build:runner && eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm build:runner && pnpm -r run typecheck",
    "test": "pnpm build:runner && pnpm -r run test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "test:integration": "pnpm -r run test:integration",
    "db:checkout:up": "pnpm --filter @faultlab/checkout migrate:up",
    "db:checkout:down": "pnpm --filter @faultlab/checkout migrate:down",
    "db:payment-provider:up": "pnpm --filter @faultlab/payment-provider migrate:up",
    "db:payment-provider:down": "pnpm --filter @faultlab/payment-provider migrate:down",
    "docker:config": "docker compose --env-file .env.example config --quiet",
    "test:orders": "pnpm --filter @faultlab/checkout test:orders",
    "test:charges": "pnpm --filter @faultlab/payment-provider test:charges",
    "test:e2e": "pnpm --filter @faultlab/e2e test:e2e",
    "dev:proxy": "pnpm --filter @faultlab/fault-proxy dev",
    "test:proxy": "pnpm --filter @faultlab/fault-proxy test",
    "build:runner": "pnpm --filter @faultlab/cli... build",
    "faultlab": "node packages/cli/dist/main.js",
    "test:scenario": "pnpm build:runner && pnpm --filter @faultlab/e2e test:scenario"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
