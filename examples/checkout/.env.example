NODE_ENV=development
PORT=3001

# Local development only. This service receives only its own database credentials.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=checkout
PGUSER=checkout_app
PGPASSWORD=checkout_dev_password
PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=2000
PGQUERY_TIMEOUT_MS=3000

PAYMENT_PROVIDER_URL=http://127.0.0.1:3002
# Optional host experiment: set this to http://127.0.0.1:3003 with pnpm dev:proxy.
PAYMENT_PROVIDER_TIMEOUT_MS=2000
