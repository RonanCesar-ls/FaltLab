# Compose-only configuration. Applications receive only their own PG* variables.
# These passwords are public development examples, not production secrets.
CHECKOUT_PORT=3001
CHECKOUT_DB_PORT=5433
CHECKOUT_DB_NAME=checkout
CHECKOUT_DB_USER=checkout_app
CHECKOUT_DB_PASSWORD=checkout_dev_password

PAYMENT_PROVIDER_PORT=3002
PAYMENT_PROVIDER_DB_PORT=5434
PAYMENT_PROVIDER_DB_NAME=payment_provider
PAYMENT_PROVIDER_DB_USER=payment_provider_app
PAYMENT_PROVIDER_DB_PASSWORD=payment_provider_dev_password

# Checkout's HTTP timeout; provider URL inside Compose uses service DNS.
PAYMENT_PROVIDER_TIMEOUT_MS=2000
