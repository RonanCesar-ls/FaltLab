# Optional: node --env-file=packages/cli/.env packages/cli/dist/main.js duplicate-charge
# Checkout itself must already route payments through the proxy.
FAULTLAB_CHECKOUT_URL=http://127.0.0.1:3001
FAULTLAB_PROVIDER_URL=http://127.0.0.1:3002
FAULTLAB_PROXY_URL=http://127.0.0.1:3003
FAULTLAB_REQUEST_TIMEOUT_MS=5000
FAULTLAB_READY_TIMEOUT_MS=30000
FAULTLAB_REPORT_DIR=reports/duplicate-charge
